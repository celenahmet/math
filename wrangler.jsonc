// ahmetcelen.com.tr: Cloudflare Workers + statik dosyalar (Vercel'den tasima, 18.11).
// Derleme: node cloudflare/build.mjs  (.cf-dist/ uretir)  ->  wrangler deploy
{
  "name": "math",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Yol DNS kaydi turuncu buluta (proxied) alininca devreye girer; gri bulutta etkisiz.
  "routes": [{ "pattern": "ahmetcelen.com.tr/*", "zone_name": "ahmetcelen.com.tr" }, { "pattern": "www.ahmetcelen.com.tr/*", "zone_name": "ahmetcelen.com.tr" }],
  "assets": {
    "directory": ".cf-dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
